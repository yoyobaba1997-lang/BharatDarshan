{
  "name": "bharatdarshan",
  "private": true,
  "version": "0.1.0",
  "description": "Multilingual Indian entertainment discovery catalogue and cross-platform add-on",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "ingest": "npm run ingest --workspace @bharatdarshan/api",
    "start:web": "npm run start --workspace @bharatdarshan/web",
    "start:api": "npm run start --workspace @bharatdarshan/api"
  }
}
