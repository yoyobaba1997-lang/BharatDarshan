# TMDB metadata API credential. Keep private and never commit real secrets.
TMDB_READ_ACCESS_TOKEN=
# Optional settings
INGEST_PAGES=1
INGEST_TYPES=movie,tv
INGEST_MODES=trending,popular,top_rated,indian_languages
INGEST_LANGUAGES=hi,ta,te,ml,kn,bn,mr,gu,pa,or,as
PORT=3000

# Optional region-aware TMDB Watch Provider metadata enrichment (bounded per run)
INGEST_PROVIDER_AVAILABILITY=0
INGEST_PROVIDER_REGIONS=IN,US,GB
INGEST_PROVIDER_LIMIT=100
# Optional intentional replacement of existing snapshot
INGEST_REPLACE=0

# Local/container deployment settings
ALLOWED_ORIGIN=*
BHARATDARSHAN_API=http://localhost:3000
API_PORT=3000
WEB_PORT=4173
